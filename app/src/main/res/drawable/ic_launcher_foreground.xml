<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Maze Pathway Ring -->
    <path
        android:pathData="M30,30h48v48h-48z"
        android:strokeWidth="5"
        android:strokeColor="#38BDF8"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Inner Maze Turn -->
    <path
        android:pathData="M42,42v24h24"
        android:strokeWidth="4"
        android:strokeColor="#818CF8"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Goal Hole (Dark pit with golden accent) -->
    <path
        android:pathData="M66,66m-8,0a8,8 0,1,1 16,0a8,8 0,1,1 -16,0"
        android:fillColor="#0B0F19" />
    <path
        android:pathData="M66,66m-6,0a6,6 0,1,1 12,0a6,6 0,1,1 -12,0"
        android:fillColor="#F59E0B"
        android:fillAlpha="0.7" />

    <!-- Ball Drop Shadow -->
    <path
        android:pathData="M45,45m-14,0a14,14 0,1,1 28,0a14,14 0,1,1 -28,0"
        android:fillColor="#40000000" />

    <!-- 3D Chrome Metal Ball Body with Linear Gradient -->
    <path
        android:pathData="M43,43m-13,0a13,13 0,1,1 26,0a13,13 0,1,1 -26,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="37"
                android:startY="37"
                android:endX="53"
                android:endY="53"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.25" android:color="#E2E8F0" />
                <item android:offset="0.6" android:color="#94A3B8" />
                <item android:offset="1.0" android:color="#334155" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular Highlight Curve on Metal Ball -->
    <path
        android:pathData="M37,35a6,6 0 0,1 6,-3"
        android:strokeWidth="2.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M39,37m-1.5,0a1.5,1.5 0,1,1 3,0a1.5,1.5 0,1,1 -3,0"
        android:fillColor="#FFFFFF" />
</vector>
